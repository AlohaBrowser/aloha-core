# Header-only target, mirroring //chrome/browser:chrome_content_browser_client:
# it lets a componentized target name the eyeo content browser client without
# depending on //chrome/browser:core, which compiles the implementation.
source_set("adblock_chrome_content_browser_client") {
  public = [ "adblock_chrome_content_browser_client.h" ]

  public_deps = [
    "//chrome/browser:chrome_content_browser_client",
    "//components/adblock/content:browser",
  ]
}
